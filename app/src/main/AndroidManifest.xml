<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        REQUEST_DELETE_PACKAGES supports the user-confirmed uninstall action.
        RECEIVE_BOOT_COMPLETED only rebuilds the next inexact profile alarm.
        POST_NOTIFICATIONS is requested only if the user enables context alerts;
        no permission grants silent control over other apps.

        Deliberately NOT requested:
          * QUERY_ALL_PACKAGES - the app list comes from LauncherApps, the
            official launcher API, which is not subject to package-visibility
            filtering. The <queries> block below covers the remaining
            PackageManager lookups.
          * KILL_BACKGROUND_PROCESSES / FORCE_STOP - LumaOS Pro does not terminate
            other applications.
          * Any accessibility or device-admin binding for core features.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- User-initiated static wallpaper changes only. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!--
        Package visibility (Android 11+). These are declarations, not
        permissions: they let LumaOS Pro see only apps that answer these intents.
          * launcher activities (the app list itself);
          * web search, web browsers, and the store, for dock seeding and
            "Search elsewhere" in the drawer;
          * icon packs for the major launcher families (appfilter.xml format).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.fede.launcher.THEME_ICONPACK" /></intent>
        <intent><action android:name="net.oneplus.launcher.icons.ACTION_PICK_ICON" /></intent>
    </queries>

    <application
        android:name=".core.LumaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.LumaOS"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        tools:targetApi="31">

        <!--
            The Home activity is also the regular app entry point. The HOME
            filter lets Android offer LumaOS Pro as a default launcher; the separate
            LAUNCHER filter makes it reachable from the app drawer and gives
            Play Store a normal launch intent. On a first ordinary launch,
            HomeActivity offers onboarding before the user chooses a role.

            singleTask + excludeFromRecents keep one launcher instance.
            Saved instance state also preserves an in-flight widget bind or
            configuration while Android recreates the activity.
        -->
        <activity
            android:name=".launcher.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LumaOS.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.LumaOS.Settings" />

        <receiver
            android:name=".context.ContextScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lumaos.pro.launcher.action.REEVALUATE_CONTEXT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".context.ContextBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Optional notification access supplies MediaSessionManager; Android protects this binding. -->
        <service
            android:name=".widgets.music.MusicNotificationListener"
            android:label="@string/music_widget_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".widgets.music.MusicWidgetProvider"
            android:label="@string/music_widget_name" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/luma_music_widget" />
        </receiver>
        <receiver android:name=".widgets.music.MusicWidgetControlReceiver" android:exported="false" />
        <receiver android:name=".widgets.battery.BatteryWidgetProvider"
            android:label="@string/battery_widget_name" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/luma_battery_widget" />
        </receiver>
        <activity android:name=".widgets.music.MusicAccessActivity"
            android:exported="false" android:label="@string/music_access_title"
            android:theme="@style/Theme.LumaOS.Settings" />

        <activity
            android:name=".wallpaper.WallpaperActivity"
            android:exported="false"
            android:label="@string/wallpaper_studio_title"
            android:theme="@style/Theme.LumaOS.Settings" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LumaOS.Settings" />
    </application>

</manifest>
