    <!-- Focus enforcement layer 2 (optional accessibility) -->
    <string name="focus_service_label">LumaOS Focus Protection</string>
    <string name="focus_service_description">Optional, off by default, and inactive until you accept the in-app disclosure. While a Work or Study focus session runs, LumaOS Pro sees which app enters the foreground so it can send you back when a restricted app opens. Only the foreground app’s package name is read, plus that app’s display name when the restriction screen is shown — no screen content, text, passwords, or input is collected, nothing is stored or shared, and nothing leaves the device.</string>
    <string name="focus_access_title">Stronger blocking</string>
    <string name="focus_access_privacy_row">Accessibility access</string>
    <string name="focus_access_privacy_subtitle">Read the disclosure, give or withdraw consent, or open Android settings to turn the service off.</string>
    <string name="focus_access_on">On — restricted apps opened from anywhere are sent back</string>
    <string name="focus_access_off">Off — only launches from LumaOS Pro are blocked</string>
    <string name="focus_access_row_awaiting">Consent given — enable access in Android settings</string>
    <string name="focus_access_row_declined">Off — you declined stronger blocking</string>
    <string name="focus_access_value_on">On</string>
    <string name="focus_access_value_off">Off</string>

    <!-- Prominent disclosure and consent (Android Play accessibility policy) -->
    <string name="focus_access_disclosure_screen_title">Stronger blocking</string>
    <string name="focus_access_back">Back</string>
    <string name="focus_access_status_title">Current status</string>
    <string name="focus_access_status_needs_disclosure">Accessibility access is off. Answer the disclosure below if you want stronger blocking.</string>
    <string name="focus_access_status_declined">You declined stronger blocking. Focus Protection still blocks apps launched from LumaOS Pro.</string>
    <string name="focus_access_status_awaiting">Consent recorded. Android accessibility access is off, so stronger blocking is inactive.</string>
    <string name="focus_access_status_active">Accessibility access is on. Stronger blocking is active while a Work or Study session runs.</string>
    <string name="focus_access_agreed_on">You agreed on %1$s.</string>
    <string name="focus_access_declined_on">You declined on %1$s.</string>
    <string name="focus_access_not_answered">You have not answered this disclosure yet.</string>
    <string name="focus_access_why_title">Why this access is needed</string>
    <string name="focus_access_why_body">Android only gives an app information about which app comes to the foreground through an accessibility service, and only when you turn that service on yourself in system settings. LumaOS Pro uses that single signal to catch a restricted app opened from a notification, Recents or another app — launches LumaOS Pro never sees.</string>
    <string name="focus_access_how_title">How it helps Focus Protection</string>
    <string name="focus_access_how_body">Layer 1 needs no permission and is always on: taps in the LumaOS Pro home screen, drawer, search, folders and shortcuts are intercepted before an app opens. Layer 2 is this optional access: when a restricted app enters the foreground during a Work or Study session, LumaOS Pro presses Home for you and shows its restriction screen. If you decline, layer 1 keeps working exactly as it does now.</string>
    <string name="focus_access_reads_title">What is accessed</string>
    <string name="focus_access_reads_body">Only the package name of the app that enters the foreground, taken from Android’s window-state-change events. Window-content retrieval, gesture injection and key-event filtering are all switched off in the service configuration, so LumaOS Pro cannot read screens, text, passwords, messages or keystrokes, and it never traverses another app’s view tree. Other fields on the event are ignored. Outside a Work or Study session the service takes no action and keeps nothing, and an app name is only looked up when it shows you the restriction screen.</string>
    <string name="focus_access_stores_title">Collected, stored or shared</string>
    <string name="focus_access_stores_body">Nothing from those events is collected, logged, stored or shared. The observed package name is compared in memory with the restriction list you saved; only that list is stored, as part of your local settings. LumaOS Pro has no account, analytics, advertising SDK, server or internet permission, so this information cannot leave your device and no third party receives it.</string>
    <string name="focus_access_control_title">Your control</string>
    <string name="focus_access_control_body">Turn the service off at any time in Android Settings → Accessibility → LumaOS Focus Protection, or withdraw consent here. Either action stops layer 2 at once; launcher blocking and every other feature keep working. You can revisit this screen from Settings, and declining is never required to use LumaOS Pro.</string>
    <string name="focus_access_agree">Agree and open Android settings</string>
    <string name="focus_access_decline">Decline</string>
    <string name="focus_access_close">Close</string>
    <string name="focus_access_manage">Open Android accessibility settings</string>
    <string name="focus_access_withdraw">Withdraw consent</string>
    <string name="focus_access_decline_note">Agreeing only records your choice. Android still asks you to enable the service on the next screen, and you can turn it off there whenever you want.</string>
    <string name="focus_access_consent_recorded">Consent recorded. Stronger blocking is active.</string>
    <string name="focus_access_declined_toast">Declined. Only launches from LumaOS Pro are blocked.</string>
    <string name="focus_access_withdrawn_toast">Consent withdrawn. Turn the service off in Android settings if it is still on.</string>
    <string name="focus_access_save_failed">Couldn’t save your choice. Please try again.</string>
    <string name="focus_unlock_length">Emergency unlock length</string>
    <string name="focus_unlock_button">Unlock for %1$d min</string>
    <string name="focus_unlock_granted">Focus unlocked for %1$d min</string>
    <string name="focus_layer_note">Layer 1 always on: launches from LumaOS Pro are intercepted. Layer 2 (optional above): with your consent and the Android Accessibility permission, restricted apps opened from anywhere are sent back. Sessions, unlocks, and restrictions end when you switch to Personal or Sleep.</string>
    <string name="focus_access_not_default">LumaOS Pro isn’t your default launcher, so Stronger blocking can only send restricted apps back to Home without showing the restriction screen. Set LumaOS Pro as default for the full experience.</string>
