    <!--
        ── Home editing ──
        Mirrors com.lumaos.pro.launcher.launcher.home.EditModeDesign 1:1.
        Tweak there for code, here for XML: the two are deliberately equal.
        None of this is reserved by the desktop: the action capsule lives inside
        the search row and the remove target floats over the clock band.
    -->
    <!-- Drop zones, aligned to the grid, visible only while an item is in the air -->
    <dimen name="luma_edit_screen_margin">24dp</dimen>
    <dimen name="luma_edit_grid_gutter">12dp</dimen>
    <dimen name="luma_edit_slot_radius">20dp</dimen>
    <!-- Contextual action capsule: exactly one 48dp search row, fully rounded -->
    <dimen name="luma_edit_action_radius">24dp</dimen>
    <dimen name="luma_edit_action_inset">2dp</dimen>
    <dimen name="luma_edit_action_elevation">12dp</dimen>
    <!-- Floating remove target, shown only during a drag -->
    <dimen name="luma_edit_remove_size">52dp</dimen>
    <dimen name="luma_edit_remove_padding">14dp</dimen>
    <dimen name="luma_edit_remove_top_margin">14dp</dimen>
