    <string name="pref_profile">Performance profile</string>
    <string name="profile_lightweight">Lightweight</string>
    <string name="profile_balanced">Balanced</string>
    <string name="profile_visual">Visual quality</string>
    <string name="profile_lightweight_desc">Fewest animations, smallest caches. Best for very low memory phones.</string>
    <string name="profile_balanced_desc">Default. Moderate animations and caching.</string>
    <string name="profile_visual_desc">Richer transitions and larger caches. Uses more memory.</string>
    <string name="pref_profile_auto">Choose automatically from device capability</string>
    <string name="pref_profile_auto_detail">Automatic (currently %1$s tier: %2$d MB RAM, %3$d cores).</string>
    <string name="profile_scope_note">A profile changes how ROLEXM draws and caches its own screens. It does not change other apps, CPU settings, or system animation scale — Android does not allow an app to do any of those.</string>

    <string name="pref_auto_optimize">Allow automatic maintenance</string>
    <string name="pref_auto_optimize_desc">Lets ROLEXM trim its own caches when they grow, subject to a cooldown.</string>

