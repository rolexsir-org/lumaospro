<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        LumaOS Pro draws its own light/dark palettes in code (see ui.Palette), so it
        does not depend on AppCompat or MaterialComponents day/night themes.
        That removes a dependency and keeps resource resolution trivial on slow
        devices. These platform themes only set window chrome.
    -->
    <style name="Theme.LumaOS" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/lumaos_accent</item>
        <item name="android:colorControlActivated">@color/lumaos_accent</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Home screen: transparent so the live wallpaper shows through. -->
    <style name="Theme.LumaOS.Home" parent="Theme.LumaOS">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Settings / onboarding: ordinary opaque window. -->
    <style name="Theme.LumaOS.Settings" parent="Theme.LumaOS">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
