<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup: settings and home layout only; measurements are excluded
         by omission and will be re-taken on the new device.

         LumaOS Vault is never included in either section. Its content lives in
         noBackupFilesDir, which these rules cannot even name, and only ciphertext
         ever leaves the device through the user-initiated encrypted backup. -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <!-- Device-to-device transfer: a direct switch should carry the history too. -->
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="databases/" />
    </device-transfer>
</data-extraction-rules>
