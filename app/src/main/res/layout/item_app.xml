<?xml version="1.0" encoding="utf-8"?>
<!--
    One app (or folder) cell: 56dp icon + 6dp gap + 11sp Regular single-line label.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="@dimen/luma_min_touch_target"
    android:orientation="vertical"
    android:paddingStart="@dimen/luma_space_xxs"
    android:paddingTop="@dimen/luma_space_xxs"
    android:paddingEnd="@dimen/luma_space_xxs"
    android:paddingBottom="@dimen/luma_space_xxs">

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/luma_icon_app"
        android:layout_height="@dimen/luma_icon_app"
        android:background="@drawable/bg_icon_placeholder"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/app_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/luma_grid_icon_label_gap"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="#D9FFFFFF"
        android:textSize="@dimen/luma_type_app_label" />

</LinearLayout>
