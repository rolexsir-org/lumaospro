<?xml version="1.0" encoding="utf-8"?>
<!--
    One app (or folder) cell.

    The label uses a shadow rather than a background plate: on a wallpaper the
    text must stay legible over arbitrary images, and a shadow is far cheaper to
    draw than a blurred scrim. Inside opaque surfaces the shadow is turned off.
    The theme supplies the label colour, typeface and ripple at runtime.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingLeft="2dp"
    android:paddingTop="6dp"
    android:paddingRight="2dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_placeholder"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/app_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:letterSpacing="0.005"
        android:lineSpacingMultiplier="1.12"
        android:maxLines="2"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />

</LinearLayout>
