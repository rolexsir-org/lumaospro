<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/battery_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/battery_glass_plate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_music_glass_dark"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/battery_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="68dp" android:layout_height="68dp">
                <ImageView android:id="@+id/battery_icon" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/battery_level" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:text="@string/battery_unknown" android:textColor="#FFF8FAFF"
                    android:fontFamily="sans-serif-light" android:textSize="19sp" android:maxLines="1" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:id="@+id/battery_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/battery_status_unknown" android:textColor="#FFC1CFDB" android:textAllCaps="true" android:letterSpacing="0.12" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/battery_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFC1CFDB" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
