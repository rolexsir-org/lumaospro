<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/builtin_widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/builtin_widget_plate" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"
        android:src="@drawable/bg_music_glass_dark" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="5dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
        <TextView android:id="@+id/builtin_widget_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#CDD2DF" android:textSize="11sp"
            android:fontFamily="sans-serif-medium" android:letterSpacing="0.19" android:maxLines="1" />
        <TextView android:id="@+id/builtin_widget_value" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="28sp"
            android:fontFamily="sans-serif-light" android:maxLines="2" android:ellipsize="end"
            android:includeFontPadding="false" />
        <TextView android:id="@+id/builtin_widget_detail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#CDD2DF" android:textSize="12sp"
            android:fontFamily="sans-serif" android:maxLines="2" android:ellipsize="end" />
        <ImageView android:id="@+id/builtin_widget_meter" android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="4dp" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
        </LinearLayout>
        <FrameLayout android:id="@+id/builtin_widget_visual" android:layout_width="62dp" android:layout_height="56dp"
            android:layout_marginStart="8dp" android:visibility="gone">
            <ImageView android:id="@+id/builtin_widget_art" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <LinearLayout android:id="@+id/builtin_widget_calendar_tile" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:visibility="gone">
                <TextClock android:id="@+id/builtin_widget_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="d" android:format24Hour="d" android:textSize="28sp" android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false" />
                <TextClock android:id="@+id/builtin_widget_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="EEE" android:format24Hour="EEE" android:textAllCaps="true" android:letterSpacing="0.14"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
