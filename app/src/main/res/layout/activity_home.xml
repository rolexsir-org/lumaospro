<?xml version="1.0" encoding="utf-8"?>
<!--
    LumaOS Pro home — unified LumaTokens geometry (24dp universal margins,
    72sp thin clock, 56dp app icons, 44dp search capsule, 88dp floating dock).
    Preserves every View ID and type contract across HomeActivity & tests.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false">

    <com.lumaos.pro.launcher.launcher.home.WallpaperArtView
        android:id="@+id/wallpaper_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.lumaos.pro.launcher.launcher.home.AmbientBackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/glass_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <com.lumaos.pro.launcher.launcher.home.DesktopLayout
        android:id="@+id/desktop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/luma_screen_margin_horizontal"
            android:layout_marginTop="@dimen/luma_space_lg"
            android:layout_marginEnd="@dimen/luma_screen_margin_horizontal"
            android:layout_marginBottom="@dimen/luma_space_xs"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cluster_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.lumaos.pro.launcher.launcher.home.ChronoDialView
                    android:id="@+id/home_dial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/clock_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/home_clock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/home_clock_description"
                        android:fontFamily="@font/inter_light"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.035"
                        android:longClickable="true"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/luma_type_display_clock"
                        android:textStyle="normal" />

                    <TextClock
                        android:id="@+id/home_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/luma_space_xxs"
                        android:format12Hour="EEEE, MMMM d"
                        android:format24Hour="EEEE, d MMMM"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.02"
                        android:longClickable="true"
                        android:textAppearance="@style/TextAppearance.Luma.Caption"
                        android:textColor="#B3FFFFFF"
                        android:textSize="@dimen/luma_type_caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/header_actions"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/home_search"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/home_search_description"
                        android:importantForAccessibility="no" />

                    <ImageButton
                        android:id="@+id/home_settings"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/home_settings_description"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/home_context"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.Luma.Overline"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/home_grid_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/luma_screen_margin_horizontal"
                android:paddingEnd="@dimen/luma_screen_margin_horizontal"
                android:paddingBottom="@dimen/luma_space_xs"
                android:scrollbars="none" />

            <com.lumaos.pro.launcher.launcher.home.PlacementGuideView
                android:id="@+id/placement_guide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/luma_screen_margin_horizontal"
                android:layout_marginEnd="@dimen/luma_screen_margin_horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_home_empty"
                android:clickable="true"
                android:drawablePadding="@dimen/luma_space_sm"
                android:focusable="true"
                android:gravity="center"
                android:maxWidth="300dp"
                android:paddingStart="@dimen/luma_space_xl"
                android:paddingTop="@dimen/luma_space_lg"
                android:paddingEnd="@dimen/luma_space_xl"
                android:paddingBottom="@dimen/luma_space_lg"
                android:text="@string/home_empty_hint"
                android:textAppearance="@style/TextAppearance.Luma.Body"
                android:textColor="#E6FFFFFF"
                android:textSize="@dimen/luma_type_body"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Primary search pill: 44dp visual capsule (minTouchTarget 48dp), 24dp universal margins -->
        <LinearLayout
            android:id="@+id/home_search_pill"
            android:layout_width="match_parent"
            android:layout_height="@dimen/luma_min_touch_target"
            android:layout_marginStart="@dimen/luma_screen_margin_horizontal"
            android:layout_marginTop="@dimen/luma_space_xs"
            android:layout_marginEnd="@dimen/luma_screen_margin_horizontal"
            android:layout_marginBottom="@dimen/luma_space_sm"
            android:background="@drawable/bg_search_pill"
            android:clickable="true"
            android:contentDescription="@string/home_search_description"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/luma_space_md"
            android:paddingEnd="@dimen/luma_space_xxs">

            <ImageView
                android:id="@+id/search_pill_icon"
                android:layout_width="@dimen/luma_icon_inline"
                android:layout_height="@dimen/luma_icon_inline"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rx_search" />

            <TextView
                android:id="@+id/search_pill_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/luma_space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/search_pill_hint"
                android:textAppearance="@style/TextAppearance.Luma.BodyLarge"
                android:textSize="@dimen/luma_type_body" />

            <ImageButton
                android:id="@+id/search_pill_voice"
                android:layout_width="@dimen/luma_min_touch_target"
                android:layout_height="@dimen/luma_min_touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_command_description"
                android:padding="@dimen/luma_space_sm"
                android:src="@drawable/ic_rx_voice" />

            <ImageButton
                android:id="@+id/search_pill_settings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Floating Dock: 88dp height, 28dp corner radius, 24dp left/right margins, 12dp bottom margin -->
        <FrameLayout
            android:id="@+id/dock_surface"
            android:layout_width="match_parent"
            android:layout_height="@dimen/luma_dock_height"
            android:layout_marginStart="@dimen/luma_screen_margin_horizontal"
            android:layout_marginEnd="@dimen/luma_screen_margin_horizontal"
            android:layout_marginBottom="@dimen/luma_dock_bottom_margin"
            android:background="@drawable/bg_dock_surface"
            android:clipChildren="false"
            android:paddingStart="@dimen/luma_space_md"
            android:paddingTop="@dimen/luma_space_md"
            android:paddingEnd="@dimen/luma_space_md"
            android:paddingBottom="@dimen/luma_space_md">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dock_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </FrameLayout>
    </com.lumaos.pro.launcher.launcher.home.DesktopLayout>

    <!-- Edit mode chrome -->
    <LinearLayout
        android:id="@+id/edit_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/luma_screen_margin_horizontal"
        android:paddingTop="@dimen/luma_space_xs"
        android:paddingEnd="@dimen/luma_space_md"
        android:paddingBottom="@dimen/luma_space_xs"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/edit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/edit_title"
                android:textAppearance="@style/TextAppearance.Luma.Title"
                android:textSize="@dimen/luma_type_heading" />

            <TextView
                android:id="@+id/edit_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/luma_space_xxs"
                android:text="@string/edit_hint"
                android:textAppearance="@style/TextAppearance.Luma.Caption"
                android:textSize="@dimen/luma_type_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/edit_done"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/luma_min_touch_target"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:minWidth="@dimen/luma_dock_height"
            android:paddingStart="@dimen/luma_space_md"
            android:paddingEnd="@dimen/luma_space_md"
            android:text="@string/edit_done"
            android:textAppearance="@style/TextAppearance.Luma.Label"
            android:textSize="@dimen/luma_type_body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/edit_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/luma_screen_margin_horizontal"
        android:layout_marginEnd="@dimen/luma_screen_margin_horizontal"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="@dimen/luma_space_xs"
        android:paddingBottom="@dimen/luma_space_xs"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/drawer_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/lumaos_scrim" />

        <LinearLayout
            android:id="@+id/drawer_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_drawer_sheet"
            android:orientation="vertical">

            <View
                android:id="@+id/drawer_top_pad"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <View
                android:id="@+id/drawer_handle"
                android:layout_width="@dimen/luma_drawer_handle_width"
                android:layout_height="@dimen/luma_drawer_handle_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/luma_space_xs"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/luma_screen_margin_horizontal"
                android:layout_marginTop="@dimen/luma_space_xs"
                android:layout_marginEnd="@dimen/luma_screen_margin_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/drawer_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/drawer_title"
                        android:textAppearance="@style/TextAppearance.Luma.TitleLarge"
                        android:textSize="@dimen/luma_type_title" />

                    <TextView
                        android:id="@+id/drawer_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/luma_space_xxs"
                        android:textAppearance="@style/TextAppearance.Luma.Caption"
                        android:textSize="@dimen/luma_type_caption" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/drawer_sort"
                    android:layout_width="@dimen/luma_min_touch_target"
                    android:layout_height="@dimen/luma_min_touch_target"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/drawer_sort_description"
                    android:padding="@dimen/luma_space_sm"
                    android:src="@drawable/ic_rx_sort" />

                <ImageButton
                    android:id="@+id/drawer_voice"
                    android:layout_width="@dimen/luma_min_touch_target"
                    android:layout_height="@dimen/luma_min_touch_target"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_command_description"
                    android:padding="@dimen/luma_space_sm"
                    android:src="@drawable/ic_rx_voice" />

                <ImageButton
                    android:id="@+id/drawer_close"
                    android:layout_width="@dimen/luma_min_touch_target"
                    android:layout_height="@dimen/luma_min_touch_target"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/drawer_close_description"
                    android:padding="@dimen/luma_space_sm"
                    android:src="@drawable/ic_rx_close" />
            </LinearLayout>

            <!-- Drawer search capsule: 44dp height, 16dp horizontal padding, 24dp screen margins -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/luma_search_bar_height"
                android:layout_marginStart="@dimen/luma_screen_margin_horizontal"
                android:layout_marginTop="@dimen/luma_space_xs"
                android:layout_marginEnd="@dimen/luma_screen_margin_horizontal"
                android:layout_marginBottom="@dimen/luma_space_xs">

                <EditText
                    android:id="@+id/search_field"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="false"
                    android:background="@drawable/bg_search_field"
                    android:drawablePadding="@dimen/luma_space_sm"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionGo|flagNoFullscreen"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:paddingStart="@dimen/luma_space_md"
                    android:paddingEnd="@dimen/luma_space_hero"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Luma.BodyLarge"
                    android:textColorHint="#FF8E8E93"
                    android:textSize="@dimen/luma_type_body" />

                <ImageButton
                    android:id="@+id/search_clear"
                    android:layout_width="@dimen/luma_min_touch_target"
                    android:layout_height="@dimen/luma_min_touch_target"
                    android:layout_gravity="end|center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_clear_description"
                    android:padding="@dimen/luma_space_sm"
                    android:src="@drawable/ic_rx_close"
                    android:visibility="gone" />
            </FrameLayout>

            <HorizontalScrollView
                android:id="@+id/drawer_chips_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/luma_screen_margin_horizontal"
                android:paddingEnd="@dimen/luma_screen_margin_horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/drawer_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/luma_space_xs" />
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/drawer_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/luma_screen_margin_horizontal"
                    android:paddingTop="@dimen/luma_space_xxs"
                    android:paddingEnd="@dimen/luma_space_xxl"
                    android:paddingBottom="@dimen/luma_space_md"
                    android:scrollbars="none" />

                <com.lumaos.pro.launcher.launcher.view.AlphaIndexView
                    android:id="@+id/alpha_index"
                    android:layout_width="@dimen/luma_min_touch_target"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:contentDescription="@string/drawer_alphabet_index_description" />

                <TextView
                    android:id="@+id/empty_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:maxWidth="300dp"
                    android:padding="@dimen/luma_space_xl"
                    android:text="@string/empty_no_apps"
                    android:textAppearance="@style/TextAppearance.Luma.Body"
                    android:textSize="@dimen/luma_type_body"
                    android:visibility="gone" />
            </FrameLayout>

            <View
                android:id="@+id/drawer_bottom_pad"
                android:layout_width="match_parent"
                android:layout_height="1dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
