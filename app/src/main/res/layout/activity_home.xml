<?xml version="1.0" encoding="utf-8"?>
<!--
    LumaOS Pro home — Liquid Glass composition, back to front.

      wallpaper art   kept for legacy LUMA themes; the default is the real wallpaper
      backdrop        existing atmosphere and wallpaper-derived colour
      glass_scrim     one quiet vertical veil for light/dark legibility
      desktop         one clock/date, aligned grid, one search, one floating dock
      edit chrome     edit-mode top bar + toolbar (gone until edit mode)
      drawer          scrim + top-rounded glass sheet with search and A-Z
      overlays        folders, menus and the widget picker are added at runtime

    Geometry uses the shared GlassGeometry scale: 20dp gutters, 26dp search
    radius, 34dp dock radius, 48dp control targets. Runtime applies semantic
    material recipes; XML colours are only inflation fallbacks. Every view id
    and type used by HomeActivityRuntimeTest is preserved.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false">

    <com.lumaos.pro.launcher.launcher.home.WallpaperArtView
        android:id="@+id/wallpaper_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.lumaos.pro.launcher.launcher.home.AmbientBackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/glass_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <com.lumaos.pro.launcher.launcher.home.DesktopLayout
        android:id="@+id/desktop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cluster_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Compatibility id: the decorative chronometer is no longer shown. -->
                <com.lumaos.pro.launcher.launcher.home.ChronoDialView
                    android:id="@+id/home_dial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/clock_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/home_clock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/home_clock_description"
                        android:fontFamily="@font/inter_light"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.035"
                        android:longClickable="true"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="56sp"
                        android:textStyle="normal" />

                    <TextClock
                        android:id="@+id/home_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:format12Hour="EEEE, MMM d"
                        android:format24Hour="EEEE, d MMM"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.1"
                        android:longClickable="true"
                        android:textAppearance="@style/TextAppearance.Luma.Overline"
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Compatibility controls: search and settings are reached through
                     the primary search and clock/date long-press. -->
                <LinearLayout
                    android:id="@+id/header_actions"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/home_search"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/home_search_description"
                        android:importantForAccessibility="no" />

                    <ImageButton
                        android:id="@+id/home_settings"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/home_settings_description"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compatibility readout: context selection is a long-press on the clock. -->
            <TextView
                android:id="@+id/home_context"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.Luma.Overline"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/home_grid_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <com.lumaos.pro.launcher.launcher.home.PlacementGuideView
                android:id="@+id/placement_guide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_home_empty"
                android:clickable="true"
                android:drawablePadding="12dp"
                android:focusable="true"
                android:gravity="center"
                android:maxWidth="300dp"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp"
                android:text="@string/home_empty_hint"
                android:textAppearance="@style/TextAppearance.Luma.Body"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- The single primary search entry. -->
        <LinearLayout
            android:id="@+id/home_search_pill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_search_pill"
            android:clickable="true"
            android:contentDescription="@string/home_search_description"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/search_pill_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rx_search" />

            <TextView
                android:id="@+id/search_pill_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/search_pill_hint"
                android:textAppearance="@style/TextAppearance.Luma.BodyLarge"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/search_pill_voice"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_command_description"
                android:padding="12dp"
                android:src="@drawable/ic_rx_voice" />

            <ImageButton
                android:id="@+id/search_pill_settings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/dock_surface"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dock_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </FrameLayout>
    </com.lumaos.pro.launcher.launcher.home.DesktopLayout>

    <!-- Edit mode chrome -->
    <LinearLayout
        android:id="@+id/edit_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/edit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/edit_title"
                android:textAppearance="@style/TextAppearance.Luma.Title"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/edit_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/edit_hint"
                android:textAppearance="@style/TextAppearance.Luma.Caption"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/edit_done"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/edit_done"
            android:textAppearance="@style/TextAppearance.Luma.Label"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/edit_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/drawer_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/lumaos_scrim" />

        <LinearLayout
            android:id="@+id/drawer_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_drawer_sheet"
            android:orientation="vertical">

            <View
                android:id="@+id/drawer_top_pad"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <View
                android:id="@+id/drawer_handle"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/drawer_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/drawer_title"
                        android:textAppearance="@style/TextAppearance.Luma.TitleLarge"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/drawer_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textAppearance="@style/TextAppearance.Luma.Caption"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/drawer_sort"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/drawer_sort_description"
                    android:padding="12dp"
                    android:src="@drawable/ic_rx_sort" />

                <ImageButton
                    android:id="@+id/drawer_voice"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_command_description"
                    android:padding="12dp"
                    android:src="@drawable/ic_rx_voice" />

                <ImageButton
                    android:id="@+id/drawer_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/drawer_close_description"
                    android:padding="12dp"
                    android:src="@drawable/ic_rx_close" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/search_field"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="false"
                    android:background="@drawable/bg_search_field"
                    android:drawablePadding="12dp"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionGo|flagNoFullscreen"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:paddingStart="16dp"
                    android:paddingEnd="54dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Luma.BodyLarge"
                    android:textColorHint="#FF6E6E73"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/search_clear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_clear_description"
                    android:padding="12dp"
                    android:src="@drawable/ic_rx_close"
                    android:visibility="gone" />
            </FrameLayout>

            <HorizontalScrollView
                android:id="@+id/drawer_chips_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/drawer_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="6dp" />
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/drawer_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="20dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />

                <com.lumaos.pro.launcher.launcher.view.AlphaIndexView
                    android:id="@+id/alpha_index"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:contentDescription="@string/drawer_alphabet_index_description" />

                <TextView
                    android:id="@+id/empty_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:maxWidth="300dp"
                    android:padding="24dp"
                    android:text="@string/empty_no_apps"
                    android:textAppearance="@style/TextAppearance.Luma.Body"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>

            <View
                android:id="@+id/drawer_bottom_pad"
                android:layout_width="match_parent"
                android:layout_height="1dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
