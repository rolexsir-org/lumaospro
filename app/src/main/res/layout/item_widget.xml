<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:padding="@dimen/luma_space_xs">

    <FrameLayout
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_frame"
        android:clipToOutline="true"
        android:padding="@dimen/luma_space_xs">

        <FrameLayout
            android:id="@+id/widget_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/widget_missing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/luma_space_sm"
            android:text="@string/widget_unavailable"
            android:textAppearance="@style/TextAppearance.Luma.Caption"
            android:textSize="@dimen/luma_type_caption"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/widget_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/widget_resize"
        android:layout_width="@dimen/luma_icon_app"
        android:layout_height="@dimen/luma_min_touch_target"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/widget_resize_description"
        android:visibility="gone">

        <View
            android:id="@+id/widget_resize_indicator"
            android:layout_width="40dp"
            android:layout_height="@dimen/luma_space_xs"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
