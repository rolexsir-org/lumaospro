<?xml version="1.0" encoding="utf-8"?>
<!-- A hosted app widget spanning the full grid width; height = rows x cell height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/widget_missing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/widget_unavailable"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Edit mode: outline + resize handle -->
    <View
        android:id="@+id/widget_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/widget_resize"
        android:layout_width="56dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/widget_resize_description"
        android:visibility="gone" />
</FrameLayout>
