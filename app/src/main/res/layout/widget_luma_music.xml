<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-compatible views only; no custom view or polling service. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/music_glass_plate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_music_glass_dark"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/music_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/music_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/music_empty_permission"
            android:textColor="#FFF5F8FC"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/music_active"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/music_art" android:layout_width="64dp" android:layout_height="64dp"
                    android:scaleType="centerCrop" android:src="@drawable/ic_music_note"
                    android:contentDescription="@string/music_artwork" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/music_player_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:text="@string/music_player" />
                    <TextView android:id="@+id/music_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold"
                        android:text="@string/music_unknown_title" />
                    <TextView android:id="@+id/music_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:text="@string/music_unknown_artist" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/music_progress_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <Chronometer android:id="@+id/music_elapsed_clock" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textSize="11sp" android:visibility="gone" />
                <TextView android:id="@+id/music_elapsed_static" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textSize="11sp" android:visibility="gone" />
                <TextView android:id="@+id/music_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center"
                android:orientation="horizontal">
                <ImageView android:id="@+id/music_previous" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:src="@drawable/ic_music_previous" android:contentDescription="@string/music_previous" />
                <ImageView android:id="@+id/music_toggle" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="10dp" android:src="@drawable/ic_music_play" android:contentDescription="@string/music_play" />
                <ImageView android:id="@+id/music_next" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:src="@drawable/ic_music_next" android:contentDescription="@string/music_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
